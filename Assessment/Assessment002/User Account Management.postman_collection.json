      "item": [
        {
          "name": "Get All Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response structure is a valid JSON object\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.be.an('object');\r",
                  "});\r",
                  "pm.test(\"Mandatory fields (first_name and email) are present\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    var userDetails = jsonData.data ? jsonData.data : jsonData;\r",
                  "    pm.expect(userDetails).to.have.property('email');\r",
                  "    pm.expect(userDetails).to.satisfy(function(user) {\r",
                  "        return user.hasOwnProperty('username') || user.hasOwnProperty('first_name');\r",
                  "    });\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
